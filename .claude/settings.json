{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.hold)",
      "Edit(./.env)",
      "Bash(git push*)",
      "Bash(git commit*)",
      "PowerShell(git push*)",
      "PowerShell(git commit*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/check.py\"; [ -f \"$f\" ] || f=\"$(pwd)/.claude/hooks/check.py\"; if [ -f \"$f\" ]; then python \"$f\"; else exit 0; fi",
            "timeout": 320,
            "statusMessage": "HOLD checks: tests, claims, secrets"
          }
        ]
      }
    ]
  }
}
