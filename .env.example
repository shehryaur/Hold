# Copy to .env and fill in. .env is gitignored and must never be committed.
# HOLD loads it with hold/env.py; real environment variables take precedence.

# ClickHouse Cloud: gateway writer (INSERT-only user, see SPEC.md 5.2)
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=hold_writer
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=1

# ClickHouse: dashboard reader (readonly user)
CLICKHOUSE_READER_USER=hold_reader
CLICKHOUSE_READER_PASSWORD=

# ClickHouse: admin, used ONLY by scripts/setup_clickhouse.py to create the table and users
CLICKHOUSE_ADMIN_USER=default
CLICKHOUSE_ADMIN_PASSWORD=

# Semgrep write scan: set to 0 to disable (the gateway then refuses no writes on scan grounds)
HOLD_SEMGREP=1

# Optional dashboard chat via NVIDIA NIM (OpenAI-compatible). Without these, the chat
# answers with built-in text labeled "local".
NIM_API_KEY=
NIM_MODEL=
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional: route the chat to a Guild agent instead.
# Keep real values only in .env. The browser talks to /api/chat; the key stays server-side.
GUILD_AI_ENDPOINT=
GUILD_AI_API_KEY=
GUILD_AI_AGENT_ID=
GUILD_AI_TIMEOUT=15
